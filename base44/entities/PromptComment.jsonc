{
  "name": "PromptComment",
  "type": "object",
  "properties": {
    "prompt_id": {
      "type": "string",
      "description": "ID of the prompt/generation"
    },
    "version_number": {
      "type": "number",
      "description": "Version number this comment is on"
    },
    "comment_text": {
      "type": "string",
      "description": "The comment content"
    },
    "author_name": {
      "type": "string",
      "description": "Name of the commenter"
    }
  },
  "required": [
    "prompt_id",
    "comment_text"
  ]
}